# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Microsoft Azure / Entra ID App Registration
# Register your app at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Set Redirect URI (Web) to: http://localhost:5000/api/auth/onedrive/callback
# Add Microsoft Graph API Delegated Permissions:
# - offline_access
# - User.Read
# - Files.Read
# - Files.Read.All
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/onedrive/callback

# Microsoft Graph Webhooks
# Public HTTPS URL where Microsoft Graph can send push notifications (e.g. ngrok: https://xxxx.ngrok-free.app/api/webhooks/onedrive)
ONEDRIVE_WEBHOOK_URL=http://localhost:5000/api/webhooks/onedrive
ONEDRIVE_CLIENT_STATE=konnect_onedrive_secret_state_token

# BullMQ & Redis (Section 2 & 5 of Architecture)
REDIS_URL=redis://localhost:6379
DEBOUNCE_QUIET_WINDOW_MS=3000
